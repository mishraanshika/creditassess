# ---------------------------------------------------------------------------
# Copy to `.env` (repo root) before running the API. Every value has a working
# default, so the demo runs with an empty file too.
# ---------------------------------------------------------------------------

ENV=development
DEBUG=true

# Postgres + pgvector. If unreachable the API falls back to an in-memory ledger
# unless PERSISTENCE_REQUIRED=true.
DATABASE_URL=postgresql+psycopg2://credit:credit@localhost:5432/credit_intelligence
PERSISTENCE_REQUIRED=false

# faiss (default) | pgvector | numpy
VECTOR_BACKEND=faiss

# Google Gemini. Leave blank to use the deterministic template underwriter.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Seed a couple of demo decisions at start-up so the dashboard is not empty.
DEMO_SEED=true

# Pipeline sizing (optional overrides)
# CI_TRAIN_ROWS=50000      # rows used for training; unset = full dataset
# CI_EMBED_ROWS=20000      # borrowers indexed into the vector store
# CI_FORCE_HASH_ENCODER=1  # skip the MiniLM download, use the offline encoder
